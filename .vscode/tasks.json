{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "colcon build",
            "type": "shell",
            "command": "colcon build --symlink-install",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "colcon build (xe only)",
            "type": "shell",
            "command": "colcon build --symlink-install --packages-select camera_node esp32s3_node sllidar_ros2_node fusion_node gui_matplotlib",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": { "kind": "build", "isDefault": false }
        },
        {
            "label": "run.sh",
            "type": "shell",
            "command": "./run.sh",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": { "kind": "test", "isDefault": true }
        }
    ]
}
