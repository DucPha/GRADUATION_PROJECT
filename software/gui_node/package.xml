<?xml version="1.0"?>
<package format="3">
  <name>autonomous_vehicle_gui</name>
  <version>0.1.0</version>
  <description>Qt5 realtime dashboard for fusion_viz_node. Replaces the MATLAB autocar_dashboard.</description>
  <maintainer email="duc@todo.todo">Pham Minh Duc</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>jsoncpp</depend>
  <depend>libqt5-core</depend>
  <depend>libqt5-gui</depend>
  <depend>libqt5-widgets</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>