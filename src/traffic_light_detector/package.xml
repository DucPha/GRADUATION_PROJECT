<?xml version="1.0"?>
<package format="3">
  <name>traffic_light_detector</name>
  <version>1.0.0</version>
  <description>NCNN traffic-light and sign detector for ROS 2 with Vulkan acceleration.</description>
  <maintainer email="duc@todo.todo">Pham Minh Duc</maintainer>
  <license>MIT</license>

  <url type="website">https://github.com/your-repo/graduation_project</url>
  <url type="repository">https://github.com/your-repo/graduation_project</url>
  <url type="bugtracker">https://github.com/your-repo/graduation_project/issues</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-ncnn-vulkan</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
