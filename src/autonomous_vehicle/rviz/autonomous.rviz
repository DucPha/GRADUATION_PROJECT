Panels:
  - Class: rviz_common/Displays
    Help: ""
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Camera Image1
        - /Lidar Points1
        - /TF1
    Splitters:
      - 300
      - 500
    Tree Height: 400
  - Class: rviz_common/Views
    Help: ""
    Name: Views
    Property Tree Widget:
      Expanded: []
      Splitters:
        - 50
        - 100
      Tree Height: 200
  - Class: rviz_common/Time
    Help: ""
    Name: Time
    Property Tree Widget:
      Expanded: []
      Splitters:
        - 50
        - 100
      Tree Height: 200
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Enabled: true
      Name: Lidar Points
      Position Transformer: XYZ
      Queue Size: 10
      Size (Pixels): 3
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Use rainbow: false
      Value: 1
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fusion_viz/image
      Max Value: 1
      Mediant Filter window: 0
      Min Value: 0
      Name: Camera Image
      Normalize Range: false
      Queue Size: 10
      Transport Hint: raw
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /traffic_light/image_debug
      Max Value: 1
      Mediant Filter window: 0
      Min Value: 0
      Name: Traffic Light Debug
      Normalize Range: false
      Queue Size: 10
      Transport Hint: raw
    - Alpha: 1
      Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /turn_detector/image_debug
      Max Value: 1
      Mediant Filter window: 0
      Min Value: 0
      Name: Turn Detector Debug
      Normalize Range: false
      Queue Size: 10
      Transport Hint: raw
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        base_link:
          laser:
            Enabled: true
            Value: true
      Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: base_link
    Frame Rate: 30
  Name: Root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Value: true
  Views:
    - Class: rviz_default_plugins/Orbit
      Distance: 10
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Use Stereo Rendering: false
      Focal Point: 0; 0; 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Name: Orbit
      Near Clip Distance: 0.01
      Pitch: 0.7853981633974483
      Target Frame: <Fixed Frame>
      Yaw: 3.141592653589793
    - Class: rviz_default_plugins/XYOrbit
      Distance: 10
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Use Stereo Rendering: false
      Focal Point: 0; 0; 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Name: XYOrbit
      Near Clip Distance: 0.01
      Pitch: 1.5707963267948966
      Target Frame: <Fixed Frame>
      Yaw: 0
    - Class: rviz_default_plugins/FirstPerson
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Use Stereo Rendering: false
      Eye Height: 1.6
      Forward Speed: 2
      Name: FirstPerson
      Near Clip Distance: 0.01
      Pitch: 0
      Target Frame: <Fixed Frame>
      Yaw: 0
Window Geometry:
  Height: 800
  Width: 1200
  X: 100
  Y: 100