<?xml version="1.0"?>
<package format="3">
  <name>autonomous_vehicle</name>
  <version>1.0.0</version>
  <description>Camera and LiDAR fusion, obstacle avoidance, and ESP32 serial control for autonomous vehicle.</description>
  <maintainer email="duc@todo.todo">Pham Minh Duc</maintainer>
  <license>MIT</license>

  <url type="website">https://github.com/your-repo/graduation_project</url>
  <url type="repository">https://github.com/your-repo/graduation_project</url>
  <url type="bugtracker">https://github.com/your-repo/graduation_project/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>cv_bridge</depend>
  <!-- OpenCV: tìm bằng find_package(OpenCV) trong CMakeLists.txt, không phải rosdep key -->
  <depend>jsoncpp</depend>

  <!-- bringup.launch.py gọi get_package_share_directory() để tìm file rviz -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>