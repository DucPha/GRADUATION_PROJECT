{
    "files.associations": {
        "*.ino": "cpp"
    },
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.default.includePath": [
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/cores/esp32",
        "${env:USERPROFILE}/.platformio/packages/framework-arduinoespressif32/variants/doitESP32devkitV1",
        "${workspaceFolder}/**"
    ],
    "C_Cpp.default.compilerPath": "${env:USERPROFILE}/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-gcc.exe",
    "C_Cpp.default.cppStandard": "gnu++11"
}